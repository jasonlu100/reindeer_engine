# Normalize line endings so the repo is consistent across Windows / macOS / Linux.
* text=auto eol=lf

# Windows-specific scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never diff or merge these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.webp binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.zip binary
